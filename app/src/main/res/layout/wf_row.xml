<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/wf_row"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView android:id="@+id/title" style="@style/WfText"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:id="@+id/sub" style="@style/WfMuted"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView android:id="@+id/right" style="@style/WfText"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="8dp" android:textStyle="bold" />
</LinearLayout>
