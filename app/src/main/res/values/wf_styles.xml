<resources>
    <style name="WfText">
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textSize">14sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
    <style name="WfMuted" parent="WfText">
        <item name="android:textColor">#FF9FB5AC</item>
        <item name="android:textSize">12sp</item>
    </style>
    <style name="WfBtn" parent="WfText">
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/wf_card</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingLeft">10dp</item>
        <item name="android:paddingRight">10dp</item>
    </style>
    <style name="WfKey" parent="WfBtn">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:background">@drawable/wf_key</item>
        <item name="android:textSize">20sp</item>
    </style>
    <style name="WfTab" parent="WfBtn">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">13sp</item>
        <item name="android:background">@android:color/transparent</item>
    </style>
    <style name="WfBar">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:orientation">horizontal</item>
    </style>
</resources>
